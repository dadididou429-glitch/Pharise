rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'vAz85zAbCTX5ipHqDowdCZBROR53';
    }

    // إحصائيات المستخدمين — قراءة للجميع / زيادة +1 فقط
    match /stats/{docId} {
      allow read: if true;
      allow create: if docId == 'users'
        && request.resource.data.count is number
        && request.resource.data.count >= 1;
      allow update: if isAdmin()
        || (docId == 'users'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
            && request.resource.data.count is number
            && request.resource.data.count == resource.data.count + 1);
      allow delete: if isAdmin();
    }

    // مستخدمون فريدون (مفتاح = installId أو uid)
    match /unique_users/{docId} {
      allow read: if isAdmin()
        || (request.auth != null && (request.auth.uid == docId || resource.data.uid == request.auth.uid));
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.installId is string
        && request.resource.data.uid is string;
      allow update: if request.auth != null
        && (request.auth.uid == docId
            || request.auth.uid == resource.data.uid
            || request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /pharmacies_submitted/{docId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.verified == false
        && request.resource.data.featured != true;
      allow update, delete: if isAdmin();
    }

    match /removed_pharmacies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pharmacy_features/{docId} {
      allow read: if true;
      allow create: if request.resource.data.featured == true;
      allow update, delete: if isAdmin();
    }

    match /activation_codes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.used == false;
      allow update: if resource.data.used == false
        && request.resource.data.used == true;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /complaints/{docId} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if isAdmin()
        || request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /ratings/{docId} {
      allow read: if true;
      allow write: if request.resource.data.sum is number
        && request.resource.data.count is number;
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.resource.data.stars is number
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow update, delete: if isAdmin();
      }
    }

    match /medicine_requests/{docId} {
      allow read: if true;
      allow create: if request.resource.data.medicineName is string
        && request.resource.data.medicineName.size() >= 2
        && request.resource.data.medicineName.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8
        && request.resource.data.whatsapp.size() <= 20;
      allow update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1000
        && request.resource.data.read == false;
      allow update, delete: if isAdmin();
    }

    match /duty_nights/{dateId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'vAz85zAbCTX5ipHqDowdCZBROR53';
    }

    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
