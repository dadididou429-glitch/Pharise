rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'vAz85zAbCTX5ipHqDowdCZBROR53';
    }

    match /pharmacies_submitted/{docId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.verified == false
        && request.resource.data.featured != true;
      allow update, delete: if isAdmin();
    }

    match /removed_pharmacies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pharmacy_features/{docId} {
      allow read: if true;
      allow create: if request.resource.data.featured == true;
      allow update, delete: if isAdmin();
    }

    match /activation_codes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.used == false;
      allow update: if resource.data.used == false
        && request.resource.data.used == true;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /complaints/{docId} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if isAdmin()
        || request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /ratings/{docId} {
      allow read: if true;
      allow write: if request.resource.data.sum is number
        && request.resource.data.count is number;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.resource.data.stars is number
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow update, delete: if isAdmin();
      }
    }
  

    // طلبات البحث عن دواء (30 يوماً)
    match /medicine_requests/{docId} {
      allow read: if true;
      allow create: if request.resource.data.medicineName is string
        && request.resource.data.medicineName.size() >= 2
        && request.resource.data.medicineName.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 10
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.active == true
        && request.resource.data.expiresAtMs is number;
      allow update, delete: if isAdmin();
    }

    // عدّاد المستخدمين العام
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

  }
}