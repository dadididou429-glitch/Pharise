rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'vAz85zAbCTX5ipHqDowdCZBROR53';
    }

    // ─────────────────────────────────────────────
    // صيدليات مُقدَّمة من المالكين (غير موثّقة تلقائيًا)
    // ─────────────────────────────────────────────
    match /pharmacies_submitted/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
            'name','address','phone','area','lat','lng',
            'hours','onDuty','verified','featured','createdAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.verified == false
        && request.resource.data.featured != true;
      allow update, delete: if isAdmin();
    }

    match /removed_pharmacies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // شارة "موثّقة/مميزة" — تفعيل من الأدمِن فقط
    // هذا هو مصدر الدخل الأول، ممنوع يُكتب من العميل
    // ─────────────────────────────────────────────
    match /pharmacy_features/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // أكواد التفعيل — تُنشأ فقط من طرفك (Admin SDK/Console)
    // العميل يقدر فقط "يستهلك" كود موجود مسبقًا
    // ─────────────────────────────────────────────
    match /activation_codes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedBy']);
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // البلاغات — مربوطة بمستخدم مسجّل لمنع بلاغات وهمية جماعية
    // (يتطلب Anonymous Auth كحد أدنى في التطبيق)
    // ─────────────────────────────────────────────
    match /complaints/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pharmacyId','count','reporterUid','createdAt'])
        && request.resource.data.count == 1
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // التقييمات — المجموع/العدّاد للقراءة فقط من العميل
    // التحديث الفعلي يصير عبر Cloud Function (functions/index.js)
    // ─────────────────────────────────────────────
    match /ratings/{docId} {
      allow read: if true;
      allow write: if false; // يُحدَّث فقط من السيرفر (Cloud Function)

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['stars','comment','createdAt','uid'])
          && request.resource.data.stars is number
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────
    // طلبات الأدوية — القراءة محدودة لحماية أرقام الهواتف
    // ─────────────────────────────────────────────
    match /medicine_requests/{docId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly([
            'medicineName','whatsapp','active','expiresAtMs','createdAt'
          ])
        && request.resource.data.medicineName is string
        && request.resource.data.medicineName.size() >= 2
        && request.resource.data.medicineName.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 10
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.active == true
        && request.resource.data.expiresAtMs is number;
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // الإحصائيات — أدمِن فقط
    // ─────────────────────────────────────────────
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
