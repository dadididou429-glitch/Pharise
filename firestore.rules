rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'vAz85zAbCTX5ipHqDowdCZBROR53';
    }

    match /pharmacies_submitted/{docId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.verified == false
        && request.resource.data.featured == false;
      allow update, delete: if isAdmin();
    }

    match /removed_pharmacies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pharmacy_features/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activation_codes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if isAdmin();
      allow update: if resource.data.used == false
        && request.resource.data.used == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /complaints/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.count == 1;
      allow update, delete: if isAdmin();
    }

    match /ratings/{docId} {
      allow read: if true;
      allow write: if false;
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.stars is number
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow update, delete: if isAdmin();
      }
    }

    match /medicine_requests/{docId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.medicineName is string
        && request.resource.data.medicineName.size() >= 2
        && request.resource.data.medicineName.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8
        && request.resource.data.whatsapp.size() <= 20
        && request.resource.data.active == true
        && request.resource.data.expiresAtMs is number;
      allow update, delete: if isAdmin();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // مستخدمون فريدون — كل uid يكتب مستنده فقط؛ العدّ للأدمن
    match /unique_users/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
