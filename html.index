<body class="bg-brand-50 text-stone-900 antialiased">
  <div id="pharis-boot" style="position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;background:#022c22;overflow:hidden">
    <div style="position:relative;width:min(100vw,380px);height:min(100vh,520px);display:flex;flex-direction:column;align-items:center;justify-content:center">
      <div class="pb-ring" style="--d:0s"></div>
      <div class="pb-ring" style="--d:0.18s"></div>
      <div class="pb-symbols">
        <span class="pb-sym" style="--a:0">📍</span>
        <span class="pb-sym" style="--a:1">✚</span>
        <span class="pb-sym" style="--a:2">💊</span>
      </div>
      <div class="pb-icon-wrap">
        <img src="./icon-192.png" alt="Pharis" width="132" height="132" class="pb-icon" fetchpriority="high" />
      </div>
      <div class="pb-name" dir="ltr">
        <span style="--i:0">P</span><span style="--i:1">h</span><span style="--i:2">a</span><span style="--i:3">r</span><span style="--i:4">i</span><span style="--i:5">s</span>
      </div>
      <p class="pb-tag">صيدليات مفتوحة · قريبة منك</p>
    </div>
  </div>
  <div id="root"></div>

  <style>
    .pb-ring{
      position:absolute;left:50%;top:40%;width:168px;height:168px;margin:-84px 0 0 -84px;
      border:1.5px solid rgba(110,231,183,0.25);border-radius:50%;
      animation:pbRing 1.4s ease-out var(--d) both;
      pointer-events:none;
    }
    @keyframes pbRing{
      0%{transform:scale(0.35);opacity:0}
      30%{opacity:0.7}
      100%{transform:scale(2.2);opacity:0}
    }
    .pb-symbols{position:absolute;left:50%;top:40%;width:0;height:0;z-index:2}
    .pb-sym{
      position:absolute;font-size:28px;left:0;top:0;opacity:0;
      animation:pbSym 0.85s cubic-bezier(0.22,1,0.36,1) calc(0.02s + var(--a)*0.08s) both;
      filter:drop-shadow(0 4px 8px rgba(0,0,0,0.3));
    }
    @keyframes pbSym{
      0%{opacity:0;transform:rotate(calc(var(--a)*120deg)) translateY(-70px) scale(0.4)}
      40%{opacity:1;transform:rotate(calc(var(--a)*120deg)) translateY(-52px) scale(1.05)}
      70%{opacity:1;transform:rotate(0deg) translateY(0) scale(0.9)}
      100%{opacity:0;transform:rotate(0deg) translateY(0) scale(0.25)}
    }
    .pb-icon-wrap{
      position:relative;z-index:3;width:132px;height:132px;border-radius:32px;
      box-shadow:0 18px 44px rgba(0,0,0,0.38),0 0 0 1px rgba(110,231,183,0.22);
      opacity:0;transform:scale(0.55);
      animation:pbIcon 0.55s cubic-bezier(0.22,1,0.36,1) 0.6s forwards;
      overflow:hidden;background:#fff;
    }
    .pb-icon{width:132px;height:132px;display:block;border-radius:32px}
    @keyframes pbIcon{
      0%{opacity:0;transform:scale(0.5)}
      65%{opacity:1;transform:scale(1.05)}
      100%{opacity:1;transform:scale(1)}
    }
    .pb-name{
      margin-top:20px;display:flex;gap:2px;justify-content:center;direction:ltr;z-index:3;
    }
    .pb-name span{
      display:inline-block;font-size:36px;font-weight:800;color:#6ee7b7;
      letter-spacing:0.05em;text-shadow:0 0 24px rgba(52,211,153,0.5);
      opacity:0;transform:translateY(12px);
      animation:pbLetter 0.35s cubic-bezier(0.22,1,0.36,1) calc(0.9s + var(--i)*0.06s) forwards;
      font-family:system-ui,-apple-system,'Segoe UI',sans-serif;
    }
    @keyframes pbLetter{
      from{opacity:0;transform:translateY(12px);filter:blur(4px)}
      to{opacity:1;transform:translateY(0);filter:blur(0)}
    }
    .pb-tag{
      margin:10px 0 0;font-size:12px;color:#a7f3d0;opacity:0;
      animation:pbLetter 0.4s ease 1.35s forwards;
      font-family:system-ui,sans-serif;
    }
  </style>

  <script>
    (function () {
      var boot = document.getElementById("pharis-boot");
      var hidden = false;
      var NAME_DONE_MS = 1450;
      var HOLD_NAME_MS = 450;
      var FADE_MS = 350;
      var audioCtx = null;

      function music() {
        try {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === "suspended") audioCtx.resume();
          var t0 = audioCtx.currentTime + 0.02;
          var master = audioCtx.createGain();
          master.gain.setValueAtTime(0.0001, t0);
          master.gain.exponentialRampToValueAtTime(0.08, t0 + 0.15);
          master.gain.setValueAtTime(0.08, t0 + 1.4);
          master.gain.exponentialRampToValueAtTime(0.0001, t0 + 1.9);
          master.connect(audioCtx.destination);

          function pad(f, s, d) {
            var o = audioCtx.createOscillator();
            var g = audioCtx.createGain();
            o.type = "sine"; o.frequency.value = f;
            g.gain.setValueAtTime(0.0001, t0 + s);
            g.gain.exponentialRampToValueAtTime(0.03, t0 + s + 0.1);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + s + d);
            o.connect(g); g.connect(master);
            o.start(t0 + s); o.stop(t0 + s + d);
          }
          function note(f, s, d, v) {
            var o = audioCtx.createOscillator();
            var g = audioCtx.createGain();
            o.type = "triangle"; o.frequency.value = f;
            g.gain.setValueAtTime(0.0001, t0 + s);
            g.gain.exponentialRampToValueAtTime(v || 0.05, t0 + s + 0.015);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + s + d);
            o.connect(g); g.connect(master);
            o.start(t0 + s); o.stop(t0 + s + d);
          }

          pad(261.63, 0, 1.8); pad(329.63, 0.08, 1.7); pad(392, 0.15, 1.6);
          note(392, 0.15, 0.2); note(523.25, 0.45, 0.25); note(659.25, 0.75, 0.25);
          note(523.25, 1.05, 0.2); note(783.99, 1.3, 0.35, 0.06);
        } catch (e) {}
      }

      music();

      function hideBoot() {
        if (hidden || !boot) return;
        hidden = true;
        boot.style.transition = "opacity " + (FADE_MS / 1000) + "s ease";
        boot.style.opacity = "0";
        try {
          if (audioCtx) {
            setTimeout(function () {
              try { audioCtx.close(); } catch (e) {}
            }, 200);
          }
        } catch (e) {}
        setTimeout(function () {
          if (boot && boot.parentNode) boot.parentNode.removeChild(boot);
        }, FADE_MS + 30);
      }

      if (boot) {
        boot.style.cursor = "pointer";
        boot.addEventListener("click", hideBoot, { once: true });
        boot.addEventListener("pointerdown", function once() {
          try { if (audioCtx && audioCtx.state === "suspended") audioCtx.resume(); music(); } catch (e) {}
        }, { once: true });
      }

      window.__pharisHideBoot = hideBoot;
      setTimeout(hideBoot, NAME_DONE_MS + HOLD_NAME_MS);
    })();
  </script>

